# Copy this file to ".env" and adjust. Never commit the real .env file.

# Flask
SECRET_KEY=replace-with-a-long-random-string
JWT_SECRET_KEY=replace-with-a-different-long-random-string
JWT_ACCESS_TOKEN_MINUTES=60

# MySQL connection: mysql+pymysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=mysql+pymysql://portal:portal_password@127.0.0.1:3306/member_portal?charset=utf8mb4

# Browser origins allowed to call the API (comma separated)
CORS_ORIGINS=http://localhost:5173

# File storage. Leave S3_BUCKET empty to store uploads on local disk.
S3_BUCKET=
AWS_REGION=us-east-1
