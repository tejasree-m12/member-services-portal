# Where the API lives. Leave as /api/v1 for local development (Vite proxies it
# to Flask) and when nginx serves the frontend and API from the same domain.
# Set a full URL if the frontend is hosted separately, e.g. on S3:
# VITE_API_BASE_URL=https://api.example.com/api/v1
VITE_API_BASE_URL=/api/v1
